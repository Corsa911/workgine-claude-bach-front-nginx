# Общие настройки http-контекста. Файл проходит через envsubst образа nginx,
# но переменные nginx ($host и т.п.) не затрагиваются: подставляются только
# заданные переменные окружения.

# Встроенный DNS Docker: nginx перечитывает адреса api/frontend,
# поэтому пересоздание контейнеров не приводит к 502.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream workgine_api {
    zone workgine_api 64k;
    server api:8000 resolve;
    keepalive 16;
}

upstream workgine_web {
    zone workgine_web 64k;
    server frontend:3000 resolve;
    keepalive 16;
}

# WebSocket (пригодится для чата); без Upgrade — пустой Connection для keepalive.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# Защита входа и регистрации от перебора: 10 запросов в минуту с IP.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_status 429;

server_tokens off;
client_max_body_size 20m;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_min_length 1024;
gzip_types text/plain text/css application/json application/javascript image/svg+xml;
