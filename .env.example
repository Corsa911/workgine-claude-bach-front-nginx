# Создаётся автоматически setup.ps1 / setup-prod.sh. Не коммитить реальный .env.
SECRET_KEY=change-me-at-least-32-random-characters
POSTGRES_PASSWORD=change-me

# Порт nginx на этом компьютере (если 80 занят, например, IIS: HTTP_PORT=8080)
HTTP_PORT=80
# 127.0.0.1 — только с этого компьютера; 0.0.0.0 — из локальной сети
HTTP_BIND=127.0.0.1

# Число процессов API
WEB_CONCURRENCY=2
# Swagger на /docs
DOCS_ENABLED=true
# Нужен только при фронте на другом домене, через запятую
CORS_ORIGINS=

# Только для docker-compose.prod.yml
DOMAIN=workgine.example.kz
LETSENCRYPT_EMAIL=admin@example.kz
